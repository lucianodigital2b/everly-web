APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Everly media storage (Cloudflare R2) ---
MEDIA_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=everly-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Public base URL bound to the bucket (r2.dev subdomain or custom domain).
R2_URL=https://media.everly.app

# --- Everly PIX checkout ---
# fake = no provider call; returns a stub invoice URL for local dev.
PIX_DRIVER=fake

# --- Social login ---
GOOGLE_CLIENT_ID=

# Sign in with Apple. Comma-separated: every bundle id the app ships mints
# identity tokens with its own `aud` (production, .dev, .preview). The first is
# the primary — the one the .p8 key is registered against.
APPLE_CLIENT_ID=com.get.everly,com.get.everly.dev,com.get.everly.preview

# Only needed to revoke the Apple grant on account deletion (App Store guideline
# 5.1.1(v)); sign-in works without them. Key from developer.apple.com →
# Certificates, Identifiers & Profiles → Keys, with "Sign in with Apple"
# enabled. Apple allows the .p8 to be downloaded exactly once.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=storage/app/private/apple/AuthKey_<KEY_ID>.p8
# Or inline instead of a path, for hosts with no writable disk:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Guest packs (RevenueCat) ---
# Exact string RevenueCat sends in the webhook's Authorization header.
# Leave blank and the webhook rejects everything (fails closed).
REVENUECAT_WEBHOOK_AUTH=
# Floor capacity a refund can never drop an event below (free tier = 5).
GUEST_PACK_BASELINE=5
# Enable the instant client-side sync endpoint. Off unless the client verifies
# store receipts — the webhook is the source of truth.
GUEST_PACK_SYNC_ENABLED=false
